{
  "manifest_version": 3,
  "name": "TurboDL",
  "version": "1.3.0",
  "description": "Envoie vos téléchargements à TurboDL (multi-connexions, torrents, reprise auto).",
  "key": "",
  "permissions": ["downloads", "cookies", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "TurboDL" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
